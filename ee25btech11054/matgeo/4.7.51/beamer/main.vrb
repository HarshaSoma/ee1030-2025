\frametitle{Python Code: plot8.py}
\begin{lstlisting}[language=Python]
import numpy as np
import matplotlib.pyplot as plt

def plane1_z(x, y): return (5-x-2*y)/3
def plane2_z(x, y): return -3*x - 3*y
def required_z(x, y): return (-7*x+8*y-25)/3

x = np.linspace(-5, 5, 40)
y = np.linspace(-5, 5, 40)
X, Y = np.meshgrid(x, y)
Z1, Z2, Zr = plane1_z(X,Y), plane2_z(X,Y), required_z(X,Y)
fig = plt.figure(figsize=(10, 7))
ax = fig.add_subplot(111, projection='3d')
ax.plot_surface(X, Y, Z1, alpha=0.5, color='cyan', label='x+2y+3z=5')
ax.plot_surface(X, Y, Z2, alpha=0.5, color='yellow', label='3x+3y+z=0')
ax.plot_surface(X, Y, Zr, alpha=0.5, color='red', label='Required Plane')
ax.scatter(-1, 3, 2, color='black', s=50, label='Point(-1,3,2)')
ax.set_xlabel('X'); ax.set_ylabel('Y'); ax.set_zlabel('Z')
ax.set_box_aspect([1,1,1])
plt.title("Perpendicular Plane through a Point")
plt.show()
\end{lstlisting}
